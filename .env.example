# Loaded by npm run demo and npm run measure:examples. Never commit .env.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Pull requests in public repositories need no token. Private repositories and
# "Post the fly's review" need one; a logged-in gh CLI is used automatically when this is empty.
GITHUB_TOKEN=

# Optional model overrides.
TYPESAFE_MODEL=jev-latest
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional isolated local lab (default: .runs). Use a different directory for a second server.
# FLY_REVIEW_DATA_DIR=.runs/verification
